generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Produto {
  id    Int    @id @default(autoincrement())
  nome  String
  preco Float
} 

model Usuario {
  id Int @id @default(autoincrement())
  nome String
  email String @unique
  senha String
  createdAt DateTime @default(now())
}